# Google Places API Key
GOOGLE_PLACES_API_KEY=your_key_here

# Google Directions API Key  
GOOGLE_DIRECTIONS_API_KEY=your_key_here

# Google Gemini API Key (via Google AI Studio)
# Used for: AI narration generation AND Gemini TTS (when TTS_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# TTS Provider — choose one of: 'gemini' | 'google' | 'elevenlabs'
# 'gemini' is the default and requires NO extra key (reuses GEMINI_API_KEY above).
# 'google' requires Google Cloud TTS enabled + TTS_API_KEY below.
# 'elevenlabs' requires an ElevenLabs account + TTS_API_KEY / ELEVENLABS_API_KEY below.
TTS_PROVIDER=gemini

# Cloud TTS API Key (only needed when TTS_PROVIDER=google or TTS_PROVIDER=elevenlabs)
# Leave blank or omit entirely when using TTS_PROVIDER=gemini.
TTS_API_KEY=  # optional — not needed for gemini provider

# ElevenLabs (only needed when TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here
